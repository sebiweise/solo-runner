# --- Credentials (one of the two) ------------------------------------------
# Fine-grained PAT: Repository access = the repos to serve, permissions
# Administration: Read and write, Actions: Read (Metadata: Read is implied).
GITHUB_TOKEN=
# Or a GitHub App installed on your account (see README):
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/app.pem
# GITHUB_APP_INSTALLATION_ID=   # only if the app has more than one installation

# --- Which repos and jobs ---------------------------------------------------
# auto = every private, non-archived repo the credential can see, re-read
# every DISCOVERY_INTERVAL seconds. Or a list: owner/repo owner/other
REPOS=auto
# Glob patterns to leave out, matched against owner/repo and repo.
REPO_EXCLUDE=
# Extra labels. A job is taken only if it asks for all of them and for nothing
# this runner lacks (self-hosted, linux, x64/arm64 are always there).
LABELS=solo
# Public repos are refused unless you set this; see README, "Security".
ALLOW_PUBLIC_REPOS=false
# Optional YAML file with labels and max_concurrent per repo (README,
# "Settings per repo"). Mount it read-only, see compose.yaml.
# CONFIG_FILE=/etc/solo-runner/config.yaml

# --- Capacity and timing ----------------------------------------------------
# Jobs at the same time on this host, across all repos.
MAX_CONCURRENT=1
POLL_INTERVAL=30
IDLE_TIMEOUT=300

# --- Operations -------------------------------------------------------------
# Called (GET) after every successful scan and at least once a minute.
HEARTBEAT_URL=
# text or json
LOG_FORMAT=text
# Runner names are <prefix>-<repo>-<time>-<slot>; default solo-runner; one per host.
RUNNER_NAME_PREFIX=
